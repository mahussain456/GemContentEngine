# Default line-ending normalization for text files
* text=auto eol=lf

# Force binary handling — never touch line endings or diff inline
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp4 binary
*.mov binary
*.zip binary
*.gz binary
*.tar binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Linguist hints — keep gem.html, landing.html in the "HTML" stats
*.html linguist-language=HTML
*.css linguist-language=CSS
